<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Staff</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/adminNavbar') %>

    <main class="container narrow-container">
        <h1>Edit Staff</h1>
        <%- include('../partials/messages') %>

        <form action="/admin/staff/<%= staffMember.userId %>/edit" method="POST" class="form-card normal-form">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" value="<%= staffMember.name %>" required>

            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= staffMember.email %>" required>

            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone" value="<%= staffMember.phone %>" required>

            <button type="submit">Update Staff</button>
        </form>
    </main>
</body>
</html>
