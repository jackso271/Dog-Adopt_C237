<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Review</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/customerNavbar') %>

    <main class="container narrow-container">
        <h1>Edit Review</h1>

        <%- include('../partials/messages') %>

        <section class="form-card review-form-card">
            <form
                class="normal-form"
                action="/customer/reviews/<%= review.reviewId %>/update"
                method="POST"
            >
                <label for="title">
                    Review Title
                </label>

                <input
                    id="title"
                    type="text"
                    name="title"
                    maxlength="120"
                    value="<%= review.title %>"
                    required
                >

                <label for="rating">
                    Rating
                </label>

                <select
                    id="rating"
                    name="rating"
                    required
                >
                    <% for (
                        let number = 5;
                        number >= 1;
                        number--
                    ) { %>

                        <option
                            value="<%= number %>"
                            <%= review.rating === number ? 'selected' : '' %>
                        >
                            <%= number %> -

                            <%= number === 5
                                ? 'Excellent'
                                : number === 4
                                ? 'Very Good'
                                : number === 3
                                ? 'Good'
                                : number === 2
                                ? 'Fair'
                                : 'Poor'
                            %>
                        </option>

                    <% } %>
                </select>

                <label for="comment">
                    Review
                </label>

                <textarea
                    id="comment"
                    name="comment"
                    rows="7"
                    maxlength="2000"
                    required
                ><%= review.comment %></textarea>

                <div class="button-row">
                    <button type="submit">
                        Save Changes
                    </button>

                    <a
                        class="button-link secondary-button"
                        href="/customer/reviews"
                    >
                        Cancel
                    </a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>