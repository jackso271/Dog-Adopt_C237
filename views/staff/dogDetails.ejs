<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= dog.name %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/staffNavbar') %>

    <main class="container detail-page">
        <%- include('../partials/messages') %>

        <img class="detail-image" src="/images/dogs/<%= dog.image %>" alt="<%= dog.name %>">
        <section>
            <h1><%= dog.name %></h1>
            <p><strong>Age:</strong> <%= dog.age %></p>
            <p><strong>Gender:</strong> <%= dog.gender %></p>
            <p><strong>Breed:</strong> <%= dog.breed %></p>
            <p><strong>Summary:</strong> <%= dog.summary %></p>
            <p><strong>Status:</strong> <%= dog.status %></p>

            <div class="button-row">
                <a class="button-link" href="/staff/dogs/<%= dog.dogId %>/edit">Edit</a>
                <a
                    class="button-link danger"
                    href="/staff/dogs/<%= dog.dogId %>/delete"
                    onclick="return confirm('Are you sure you want to delete <%= dog.name %>?')"
                >Delete</a>
            </div>
        </section>
    </main>
</body>
</html>
